# Anki Pi 環境變數範本
# 複製此檔案為 .env 並填入您的設定
# cp .env.example .env

# Flask 密鑰 (生產環境必須設定，建議使用 openssl rand -hex 32 產生)
SECRET_KEY=your-secret-key-here

# 資料庫路徑 (預設: 專案根目錄下的 flashcards.db)
DATABASE_PATH=flashcards.db

# Discord Webhook URL (選填，用於發送通知)
# 格式: https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_URL=

# Flask 環境 (development / production)
# FLASK_ENV=development
